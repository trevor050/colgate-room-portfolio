## Client (Vite, baked in at build time)
# PostHog is optional. Leave the key empty to skip it entirely.
VITE_PUBLIC_POSTHOG_KEY=
# Dossier tracker endpoint. Defaults to /api/collect; "off" disables tracking.
VITE_TRACKER_ENDPOINT=/api/collect
# Where Dossier keeps the visitor id: localStorage (default) or cookie.
VITE_TRACKER_PERSIST=localStorage

## Server (Vercel Functions in api/, and `npx dossier migrate` locally)
# Postgres connection string. Use your provider's pooled URL on Vercel.
DATABASE_URL=postgres://user:password@host:5432/db
# Dashboard password for /api/admin, at least 16 characters (`npx dossier token` makes one).
# ADMIN_TOKEN from Dossier 0.1 still works if it is long enough.
DOSSIER_ADMIN_TOKEN=

# Optional: extra hosts allowed to post events cross-origin (same-origin always works).
DOSSIER_ALLOWED_HOSTS=
# Optional: IP enrichment. See the Dossier README for what each provider gives you.
IPINFO_TOKEN=
