{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/api/:path*/",
      "destination": "/api/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/_i/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
